{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  // Tests are run from source with `tsx --test` (see the `test` script), so
  // compiling them only bloats the production image with code that never
  // executes there — and ships fixture-building helpers alongside the app.
  "exclude": ["node_modules", "dist", "scripts", "src/**/*.test.ts"]
}
